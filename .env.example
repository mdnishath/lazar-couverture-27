# ─────────────────────────────────────────────────────────────
#  Réception des demandes de devis
#  Sans l'une de ces deux clés, le formulaire renvoie le visiteur
#  vers le téléphone et la demande n'arrive PAS par e-mail.
#  Copier ce fichier en .env.local (dev) ou saisir les variables
#  dans l'hébergeur (Vercel > Settings > Environment Variables).
# ─────────────────────────────────────────────────────────────

# Adresse qui reçoit les demandes (par défaut : celle de src/lib/site.ts)
DEVIS_EMAIL=contact@lazarcouverture27.com

# Option A — Resend. Meilleure délivrabilité (envoi depuis notre domaine),
# mais exige de vérifier lazarcouverture27.com par enregistrements DNS.
# https://resend.com — offre gratuite 3 000 e-mails/mois
RESEND_API_KEY=

# Option B — Web3Forms. Aucune configuration DNS, opérationnel en 2 minutes :
# on saisit l'adresse de réception, on reçoit la clé par e-mail.
# À utiliser le jour de la mise en ligne si le DNS n'est pas encore vérifié.
# https://web3forms.com — offre gratuite 250 envois/mois
WEB3FORMS_ACCESS_KEY=

# Meme cle que ci-dessus, exposee au navigateur : le plan gratuit de
# Web3Forms n'accepte QUE les envois cote client (une requete serveur
# recoit 403). C'est une cle publique par conception.
# Plusieurs destinataires : une cle par adresse, separees par une virgule
# (la mise en copie est reservee au plan Pro).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
